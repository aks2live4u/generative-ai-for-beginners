<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed brand color, edge-to-edge across the whole 108x108 adaptive icon canvas. The OS
     applies the circle/squircle/rounded-square mask on top of this - launchers that don't apply
     any mask (rendering a plain square) still show a clean solid-color icon, not a black box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#6366F1" />
</shape>
