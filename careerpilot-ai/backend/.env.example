# Copy this file to .env and fill in real values. Never commit .env.

# Postgres in docker-compose, or sqlite:///./careerpilot.db for zero-setup local dev
DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot

# Pick ONE provider by filling in its key. If both are set, Gemini wins
# unless you set AI_PROVIDER explicitly. Leave both blank to run fully on
# deterministic fallback logic (no external calls, no cost).

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: force "openai" or "gemini" instead of auto-detecting from
# whichever key is set above.
AI_PROVIDER=

# Comma-separated Greenhouse/Lever company board slugs to poll for jobs
GREENHOUSE_COMPANIES=stripe,gitlab,cloudflare
LEVER_COMPANIES=netflix

# Frontend origin(s) allowed to call this API
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
