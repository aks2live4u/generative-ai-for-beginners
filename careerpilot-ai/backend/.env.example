# Copy this file to .env and fill in real values. Never commit .env.

# Postgres in docker-compose, or sqlite:///./careerpilot.db for zero-setup local dev
DATABASE_URL=postgresql://careerpilot:careerpilot@localhost:5432/careerpilot

# Get a key at https://platform.openai.com/api-keys
# Leave blank to run fully on deterministic fallback logic (no external calls).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated Greenhouse/Lever company board slugs to poll for jobs
GREENHOUSE_COMPANIES=stripe,gitlab,cloudflare
LEVER_COMPANIES=netflix

# Frontend origin(s) allowed to call this API
CORS_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
