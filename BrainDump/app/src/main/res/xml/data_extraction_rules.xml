<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never back up encrypted secrets (API keys, PIN hash) or the master key -->
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="../shared_prefs/secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="../shared_prefs/secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
