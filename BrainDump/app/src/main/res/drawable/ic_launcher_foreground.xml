    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bulb outline -->
    <path
        android:pathData="M36,48 A18,18 0 1 1 72,48 A18,18 0 1 1 36,48 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:fillColor="#00000000" />

    <!-- Brainwave / idea filament -->
    <path
        android:pathData="M42,54 L48,42 L54,50 L60,38 L66,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Screw base -->
    <path android:pathData="M45,66 L63,66 L63,71 L45,71 Z" android:fillColor="#FFFFFF" />
    <path android:pathData="M47,74 L61,74 L61,78 L47,78 Z" android:fillColor="#FFFFFF" />
</vector>
