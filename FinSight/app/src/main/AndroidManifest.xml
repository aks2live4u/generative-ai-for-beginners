<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Read-only data sources. The app never sends SMS/email or accesses bank apps directly. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Gmail OAuth (read-only scope) + encrypted Drive backup upload. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Biometric unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Local notification for scan progress / bill reminders -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Periodic background scan/backup work -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".FinSightApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinSight"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FinSight"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads incoming bank/UPI SMS in real time. Read-only: never composes or sends SMS. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Reads notifications only from the user-approved finance/delivery app allow-list
             defined in NotificationTransactionParser; never posts or dismisses notifications. -->
        <service
            android:name=".notifications.FinanceNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- WorkManager on-demand initialization: other AAR manifests (Room, SQLCipher, Play
             Services Auth) merge into the same androidx-startup provider entry and were dropping
             the default WorkManagerInitializer, causing "WorkManager is not initialized properly"
             on launch. We disable the auto-initializer here and provide config via
             FinSightApp.Configuration.Provider instead, which WorkManager.getInstance() picks up
             lazily on first call regardless of manifest merge order. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
